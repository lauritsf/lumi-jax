# Validate native RCCL and the OFI plugin before the kernel layers.
Bootstrap: localimage
From: {{ BASE }}

%post
    set -eux
    chmod -R a+rX /opt/lumi-jax-tools
    bash /opt/lumi-jax-tools/verify_native_rocm.sh
    test -f /usr/lib/x86_64-linux-gnu/librccl-net.so
    python3 -c "import ctypes; ctypes.CDLL('/usr/lib/x86_64-linux-gnu/librccl-net.so')"

%test
    python3 -c "import jax; print(jax.devices()); assert jax.device_count() >= 1"

%labels
    Description Native RCCL 2.27.7 and OFI plugin validation stage
    BaseImage {{ BASE }}
    ROCm 7.2.4
    RCCL 2.27.7

%help
    The native RCCL and network plugin are inherited from the LAIF base.
    Validate multi-node collectives on compute nodes before publishing products.
