# JAX on the native ROCm 7.2 LAIF MPICH layer.
Bootstrap: localimage
From: {{ BASE }}

%files
    tools/verify_native_rocm.sh /opt/lumi-jax-tools/verify_native_rocm.sh
    tools/install_jax_stack.sh /opt/lumi-jax-tools/install_jax_stack.sh
    tools/install_xla_flags_hook.sh /opt/lumi-jax-tools/install_xla_flags_hook.sh

%post
    set -eux
    chmod -R a+rX /opt/lumi-jax-tools
    bash /opt/lumi-jax-tools/verify_native_rocm.sh
    python3 -m venv /opt/venv
    /opt/venv/bin/python -m pip install --no-cache-dir --upgrade pip
    bash /opt/lumi-jax-tools/install_jax_stack.sh 0.9.1

%environment
    export PATH=/opt/venv/bin:$PATH

%test
    python3 -c "import jax; d=jax.devices(); print(d); assert len(d) >= 1"
    python3 -c "import jax.numpy as jnp; x=jnp.ones((256,256)); assert float((x@x).sum()) == 256**3"

%labels
    Description JAX on the native ROCm 7.2.4 MPICH layer
    JAX 0.9.1
    JAXPlugin 0.9.1.post5
    BaseImage {{ BASE }}
    ROCm 7.2.4
    RCCL 2.27.7

%help
    JAX 0.9.1 on gfx90a with native RCCL and hipBLASLt.
    Load the LUMI singularity bindings module before running the image.
