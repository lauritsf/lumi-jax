# FFI output is specific to the parent's JAX headers.
Bootstrap: localimage
From: {{ BASE }}

%files
    csrc/flash /opt/lumi-jax-release/csrc/flash
    lumi_kernels /opt/lumi-jax-release/lumi_kernels
    pyproject.toml /opt/lumi-jax-release/pyproject.toml
    tools/install_xla_flags_hook.sh /opt/lumi-jax-tools/install_xla_flags_hook.sh
    {{ CK_FMHA_SRC }}/lib/libck_fmha.so /opt/ck-fmha/lib/libck_fmha.so
    {{ CK_FMHA_SRC }}/include /opt/ck-fmha/include

%post
    set -eux
    # Rebuilding on a product image must not retain removed Python modules or libraries.
    rm -rf /opt/lumi-jax /opt/aotriton /opt/causal-conv1d /opt/fa-src /opt/ck-fmha/src
    mv /opt/lumi-jax-release /opt/lumi-jax
    chmod -R a+rX /opt/lumi-jax /opt/ck-fmha /opt/lumi-jax-tools
    rm -rf /opt/lumi-jax/lumi_kernels/lib
    find /opt/lumi-jax -type d -name __pycache__ -prune -exec rm -rf {} +
    python3 - <<'PYLABELS'
import json
from pathlib import Path
p = Path("/.singularity.d/labels.json")
labels = json.loads(p.read_text())
for key in ("Description", "BaseImage", "Kernels", "NotIncluded", "SrcMamba", "SrcCausalConv"):
    labels.pop(key, None)
p.write_text(json.dumps(labels))
PYLABELS
    . /opt/venv/bin/activate
    bash /opt/lumi-jax-tools/install_xla_flags_hook.sh /opt/venv/lib/python3.12/site-packages /opt/venv/bin/python3
    cd /opt/lumi-jax
    pip install --no-cache-dir -c /opt/venv/lumi-jax-constraints.txt 'ray[tune]' -e .
    export CK_FMHA_ROOT=/opt/ck-fmha
    bash csrc/flash/build_ffi.sh
    python3 -c 'import importlib.util; assert importlib.util.find_spec("torch") is None'
    for so in /opt/ck-fmha/lib/libck_fmha.so /opt/lumi-jax/lumi_kernels/lib/liblumi_fa_ffi.so; do
        test -s "$so"
        if readelf -d "$so" | grep -qE 'NEEDED.*(torch|c10)'; then exit 1; fi
        if readelf -d "$so" | grep -E 'R(UN)?PATH' | grep -qE '/scratch|/pfs|/projappl'; then exit 1; fi
        if ldd "$so" | grep -q 'not found'; then exit 1; fi
    done

%environment
    unset AOTRITON_ROOT CAUSAL_CONV1D_ROOT FA_SRC_ROOT
    export CK_FMHA_ROOT=/opt/ck-fmha
    export PYTHONPATH=/opt/lumi-jax:${PYTHONPATH:-}

%test
    . /opt/venv/bin/activate
    python3 -c 'from pathlib import Path; import lumi_kernels; assert sorted(p.name for p in (Path(lumi_kernels.__file__).parent/"lib").glob("*.so")) == ["liblumi_fa_ffi.so"]'

%labels
    Description JAX with standalone CK attention
    BaseImage {{ BASE }}
    Kernels flash
