# Stage 2 of the full line: build our five XLA-FFI kernel targets into the stage-1 image.
#   sbatch containers/build_jax_torch_kernels.sbatch

# BASE comes from the build script via --build-arg (tools/image_name.sh).
Bootstrap: localimage
From: {{ BASE }}

%files
    # Our sources only: the pinned upstream trees (/opt/fa-src) came in with stage 1.
    csrc /opt/lumi-jax/csrc
    lumi_kernels /opt/lumi-jax/lumi_kernels
    pyproject.toml /opt/lumi-jax/pyproject.toml

    # Same standalone CK FMHA artifact the lean chain's jax-ck-fmha.def copies.
    {{ CK_FMHA_SRC }}/lib/libck_fmha.so /opt/ck-fmha/lib/libck_fmha.so
    {{ CK_FMHA_SRC }}/include /opt/ck-fmha/include
    {{ CK_FMHA_SRC }}/src /opt/ck-fmha/src

%post
    set -eux
    . /opt/jax-venv/bin/activate
    export FA_SRC_ROOT=/opt/fa-src

    # Clear before building, exactly as jax-kernels-lean.def does: %files re-copied the
    # builder's checkout, so a kernel that fails to build here would leave the submitter's
    # stale .so in place and the `test -s` assert below would pass on it.
    rm -f /opt/lumi-jax/lumi_kernels/lib/*.so
    rm -rf /opt/lumi-jax/lumi_kernels/__pycache__ /opt/lumi-jax/csrc/*/__pycache__

    # --- standalone AOTriton and CK FMHA on the full line ---
    # Without these, csrc/aotriton and csrc/flash fall back to torch's copies, putting our
    # ABIs in PyTorch's hands and making the two lines ship different binaries.
    AOT_VER=0.11.1b
    AOT_ROCM=rocm7.0          # matches the base's ROCm 7.0.2
    AOT_ARCH=amd-gfx90a       # MI250X; LUMI has nothing else
    AOT_BASE="https://github.com/ROCm/aotriton/releases/download/${AOT_VER}"
    mkdir -p /opt/aotriton /tmp/aot
    cd /tmp/aot
    curl -fsSLO "${AOT_BASE}/aotriton-${AOT_VER}-manylinux_2_28_x86_64-${AOT_ROCM}-shared.tar.gz"
    curl -fsSLO "${AOT_BASE}/aotriton-${AOT_VER}-images-${AOT_ARCH}.tar.gz"
    tar xzf "aotriton-${AOT_VER}-manylinux_2_28_x86_64-${AOT_ROCM}-shared.tar.gz" \
        -C /opt/aotriton --strip-components=1
    tar xzf "aotriton-${AOT_VER}-images-${AOT_ARCH}.tar.gz" \
        -C /opt/aotriton --strip-components=1
    cd / && rm -rf /tmp/aot

    test -e /opt/aotriton/lib/libaotriton_v2.so
    test -e /opt/aotriton/include/aotriton/flash.h
    test -d "/opt/aotriton/lib/aotriton.images/${AOT_ARCH}"
    # v3 takes its params struct BY REFERENCE, so a layout change is silent corruption.
    WANT='aotriton::v3::flash::attn_fwd(aotriton::v3::flash::attn_fwd_params const&, int, aotriton::StreamTemplate<ihipStream_t*>, aotriton::v3::flash::attn_options const*)'
    nm -DC /opt/aotriton/lib/libaotriton_v2.so | grep -qF "$WANT" \
        || { echo "FATAL: v3 attn_fwd signature is not what csrc/aotriton expects"; exit 1; }

    chmod -R a+rX /opt/ck-fmha /opt/aotriton
    test -e /opt/ck-fmha/lib/libck_fmha.so
    test -e /opt/ck-fmha/include/fmha_fwd.hpp
    test -d /opt/ck-fmha/include/ck_tile
    if readelf -d /opt/ck-fmha/lib/libck_fmha.so | grep -qE 'NEEDED.*(torch|c10)'; then
        echo "FATAL: libck_fmha.so links libtorch"; exit 1
    fi
    for s in fmha_fwd fmha_bwd fmha_fwd_splitkv fmha_fwd_appendkv; do
        nm -DC /opt/ck-fmha/lib/libck_fmha.so \
            | grep -qE " T (float )?${s}(<[0-9]+>)?\(" \
            || { echo "FATAL: ${s} not exported"; exit 1; }
    done

    # Already the scripts' defaults; exported anyway, since a silent default is the risk.
    export AOTRITON_ROOT=/opt/aotriton
    export CK_FMHA_ROOT=/opt/ck-fmha

    # Ray Tune into /opt/jax-venv, OUR venv -- never /opt/venv, LAIF's torch env, where
    # resolving ray's protobuf/pydantic moves a pin under torch/vllm.
    pip install --no-cache-dir -c /opt/jax-venv/lumi-jax-constraints.txt 'ray[tune]'
    python3 - <<'PYEOF'
import importlib.metadata as md
import ray, ray.tune, torch, jax
print("ray", ray.__version__, "| torch", torch.__version__, "| jax", jax.__version__)
assert torch.__version__.startswith("2.10.0"), torch.__version__
assert jax.__version__ == md.version("jax"), (jax.__version__, md.version("jax"))
PYEOF

    cd /opt/lumi-jax
    pip install --no-cache-dir -e .

    # Exit codes per pid: a bare `wait` reports only the last job's status.
    mkdir -p /tmp/kbuild
    pids=""
    for s in sscan/build_sscan.sh conv1d/build_conv1d.sh flash/build_ffi.sh \
             aotriton/build_aotriton.sh vllm/build_vllm_ffi.sh; do
        name="$(basename "$(dirname "$s")")"
        ( bash "csrc/$s" > "/tmp/kbuild/$name.log" 2>&1 ) &
        pids="$pids $!:$name"
        echo "started $name (pid $!)"
    done

    rc=0
    for p in $pids; do
        pid="${p%%:*}"; name="${p##*:}"
        if wait "$pid"; then
            echo "=== $name OK ==="
        else
            echo "=== $name FAILED ==="; rc=1
        fi
        tail -25 "/tmp/kbuild/$name.log"
    done
    [ "$rc" -eq 0 ] || { echo "FATAL: one or more kernel builds failed"; exit 1; }

    # A partial kernel set surfaces much later as a FileNotFoundError from lumi_kernels._lib.
    for so in liblumi_sscan.so liblumi_conv1d.so liblumi_fa_ffi.so liblumi_aotriton.so \
              liblumi_vllm_ffi.so; do
        test -s "/opt/lumi-jax/lumi_kernels/lib/$so" \
            || { echo "FATAL: $so was not built"; exit 1; }
        echo "built: $so"
    done

    # ...and that flash took the STANDALONE branch: the torch fallback is silent and
    # successful, so only the NEEDED list tells the two apart.
    readelf -d /opt/lumi-jax/lumi_kernels/lib/liblumi_fa_ffi.so | grep -q 'NEEDED.*libck_fmha' \
        || { echo "FATAL: liblumi_fa_ffi.so did not link the standalone libck_fmha.so"; exit 1; }
    if readelf -d /opt/lumi-jax/lumi_kernels/lib/liblumi_fa_ffi.so \
         | grep -qE 'NEEDED.*(flash_attn_2_cuda|torch|c10)'; then
        echo "FATAL: liblumi_fa_ffi.so still links the torch flash extension"; exit 1
    fi
    if readelf -d /opt/lumi-jax/lumi_kernels/lib/liblumi_aotriton.so \
         | grep -qE 'NEEDED.*(torch|c10)'; then
        echo "FATAL: liblumi_aotriton.so links libtorch"; exit 1
    fi
    echo "flash and aotriton both link the standalone libraries"

    rm -rf /tmp/kbuild

    # MAKE THE RESULT READABLE BY A NORMAL USER: %files preserves mode and this checkout's
    # lumi_kernels/ is 0770, so it lands root-only -- fine during %post, a PermissionError
    # for every image user. Must be here; stage 1 runs before the copy.
    chmod -R a+rX /opt/lumi-jax
    test -r /opt/lumi-jax/lumi_kernels/lib/liblumi_sscan.so \
        || { echo "FATAL: kernels still unreadable after chmod"; exit 1; }

    ls -la /opt/lumi-jax/lumi_kernels/lib/

%test
    # The IMAGE's path, not lumi_kernels.__file__, which follows an editable install out to
    # a checkout. %test is root, so the mode must be checked explicitly.
    . /opt/jax-venv/bin/activate
    python3 -c "
import os, stat
d = '/opt/lumi-jax/lumi_kernels/lib'
k = sorted(f for f in os.listdir(d) if f.endswith('.so'))
print('kernels:', k); assert len(k) == 5, k
for p in [d, '/opt/lumi-jax/lumi_kernels'] + [os.path.join(d, f) for f in k]:
    m = os.stat(p).st_mode
    assert m & stat.S_IROTH, ('not world-readable: %s %o' % (p, m & 0o777))
print('all 5 kernels present and world-readable')
"

%labels
    Description   JAX + prebuilt FFI kernels on the LAIF full layer, shim-free
    Stage         2 (kernels) on {{ BASE }}
    SrcMamba      77069de
    SrcCausalConv 0d2252d
    SrcFlashAttn  bbe25ba

%help
    Stage 1 (containers/jax-torch-base.def) plus our five XLA-FFI kernel libraries, prebuilt
    at /opt/lumi-jax/lumi_kernels/lib, and ray[tune].

    Developing kernels against this image: install the repo editable in your own environment
    and its lumi_kernels/lib wins, because lumi_kernels._lib resolves lib/ relative to the
    imported package. Rebuild inside the image with FA_SRC_ROOT=/opt/fa-src.
