    containers/patches/rocr-7874.patch /opt/lumi-jax-rocr/rocr-7874.patch

%post
    set -eu
    chmod -R a+rX /opt/lumi-jax-rocr
    ldd /opt/rocm/lib/libhsa-runtime64.so.1 > /tmp/rocr-ldd
    cat /tmp/rocr-ldd
    ! grep -q 'not found' /tmp/rocr-ldd
    rm /tmp/rocr-ldd

%labels
