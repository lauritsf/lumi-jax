Bootstrap: localimage
From: {{BASE}}

%files
    {{PAYLOAD}}/libhsa-runtime64.so.1.18.0 /opt/rocm-7.2.4/lib/libhsa-runtime64.so.1.18.70204
    {{PAYLOAD}}/manifest.json /opt/lumi-jax-rocr/manifest.json
