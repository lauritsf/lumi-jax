# Retarget a kernel-free stage while retaining the native ROCm libraries.
Bootstrap: localimage
From: {{ BASE }}

%files
    tools/verify_native_rocm.sh /opt/lumi-jax-tools/verify_native_rocm.sh
    tools/install_jax_stack.sh /opt/lumi-jax-tools/install_jax_stack.sh
    tools/install_xla_flags_hook.sh /opt/lumi-jax-tools/install_xla_flags_hook.sh

%post
    set -eux
    chmod -R a+rX /opt/lumi-jax-tools
    unset PYTHONPATH
    bash /opt/lumi-jax-tools/verify_native_rocm.sh
    bash /opt/lumi-jax-tools/install_jax_stack.sh {{ JAXVER }}

%environment
    export PATH=/opt/venv/bin:$PATH
    unset PYTHONPATH

%test
    python3 -c "import jax; print(jax.__version__,jax.devices()); assert jax.__version__ == '{{ JAXVER }}'; assert jax.device_count() >= 1"

%labels
    Description JAX {{ JAXVER }} on native ROCm 7.2.4
    BaseImage {{ BASE }}
    JAX {{ JAXVER }}
    ROCm 7.2.4
    RCCL 2.27.7

%help
    This stage swaps JAX pins in /opt/venv without patching ROCm libraries.
